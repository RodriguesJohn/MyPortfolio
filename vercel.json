{
  "redirects": [
    {
      "source": "/course",
      "destination": "https://www.humanaistudio.io/academy",
      "permanent": false
    },
    {
      "source": "/design-engineering-course/:path*",
      "destination": "https://www.humanaistudio.io/academy",
      "permanent": false
    },
    {
      "source": "/workshops",
      "destination": "https://maven.com/humanaistudio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
